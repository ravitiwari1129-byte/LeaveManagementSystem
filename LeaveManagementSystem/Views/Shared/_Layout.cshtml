<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Leave Management System - @ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</head>
<body>
    @{
        var userRole = Context.Session.GetString("UserRole");
        var userName = Context.Session.GetString("EmployeeName");
        var isLoggedIn = !string.IsNullOrEmpty(userName);
    }

    @if (isLoggedIn)
    {
        <header class="top-header">
            <div class="header-left">
                <h1>Leave Management System</h1>
                <p>Track and manage leave requests efficiently</p>
            </div>

            <div class="header-right">
                <span class="user-name">
                    <i class="fas fa-user"></i>
                    @Context.Session.GetString("EmployeeName")
                    (@Context.Session.GetString("UserRole"))
                </span>

                <a href="@Url.Action("Logout","Account")" class="logout-btn">
                    Logout
                </a>
            </div>
        </header>
        <div class="container">
            <div class="sidebar">
                <a href="@Url.Action("Dashboard", "Report")" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">📊 Dashboard</a>
                @if (userRole == "Admin" || userRole == "Manager")
                {
                    @if (userRole == "Admin")
                    {
                        <a href="@Url.Action("Index", "Employee")" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")">👥 Employees</a>
                        <a href="@Url.Action("Index", "Report")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Leave" ? "active" : "")">📋 Report</a>
                    }
                    <a href="@Url.Action("Index", "Leave")" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Leave" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">✅ Approve Leave</a>
                }
                else
                {
                    <a href="@Url.Action("Apply", "Leave")" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Apply" ? "active" : "")">📝 Apply Leave</a>
                    <a href="@Url.Action("Index", "LeaveHistory")" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "LeaveHistory" ? "active" : "")">📜 Leave History</a>
                    <a href="@Url.Action("Search", "Leave")" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Search" ? "active" : "")">🔍 Search Leave</a> 
                }
            </div>
            <div class="main-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" id="successAlert">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error" id="errorAlert">@TempData["Error"]</div>
                }
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }
</body>
</html>

