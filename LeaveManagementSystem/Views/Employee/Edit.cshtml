@model LeaveManagementSystem.Models.EmployeeModel
@{
    ViewBag.Title = "Edit Employee";
}

<div class="page-header">
    <h2>Edit Employee</h2>
    <p>Update employee information</p>
</div>

<div class="card">
    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
        @Html.HiddenFor(m => m.EmployeeId)
        @Html.HiddenFor(m => m.Password)
        @Html.HiddenFor(m => m.ProfileImage)

        <div class="form-group">
            <label>Employee Name *</label>
            @Html.TextBoxFor(m => m.EmployeeName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.EmployeeName, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Email *</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Mobile Number *</label>
            @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Date of Birth *</label>
            @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Age</label>
            <input type="text" class="form-control" value="@Model.Age" readonly />
        </div>

        <div class="form-group">
            <label>Gender *</label>

            <label>
                @Html.RadioButtonFor(m => m.Gender, "Male") Male
            </label>

            <label>
                @Html.RadioButtonFor(m => m.Gender, "Female") Female
            </label>

            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Department *</label>
            @Html.DropDownListFor(m => m.DepartmentId, new SelectList(ViewBag.Departments, "DepartmentId", "DepartmentName", Model.DepartmentId), "Select Department", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Role *</label>
            @if (Model.EmployeeId > 0)  
            {
                @Html.DropDownListFor(m => m.Role, new SelectList(ViewBag.Roles, "RoleName", "RoleName", Model.Role),"Select Role", new { @class = "form-control" })
            }
            else  
            {
                @Html.HiddenFor(m => m.Role, new { @Value = "Employee" })
                <input type="text" class="form-control" value="Employee" readonly />
            }
            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Salary *</label>
            @Html.TextBoxFor(m => m.Salary, new { @class = "form-control", type = "number" })
            @Html.ValidationMessageFor(m => m.Salary, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Joining Date *</label>
            @Html.TextBoxFor(m => m.JoiningDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.JoiningDate, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Skills *</label>
            @Html.TextBoxFor(m => m.Skills, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Skills, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Address *</label>
            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3" })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Profile Image</label>

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="~/uploads/@Model.ProfileImage"
                     width="100"
                     height="100"
                     style="display:block;margin-bottom:10px;" />
            }

            @Html.TextBoxFor(m => m.ImageFile,
                new
                {
                    @class = "form-control",
                    type = "file",
                    accept = ".jpg,.jpeg,.png"
                })

            @Html.ValidationMessageFor(m => m.ImageFile, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>
                @Html.CheckBoxFor(m => m.IsActive)
                Active
            </label>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="@Url.Action("Index", "Employee")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>


