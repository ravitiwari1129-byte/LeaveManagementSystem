@model LeaveManagementSystem.Models.EmployeeModel
@{
    ViewBag.Title = "Add Employee";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<div class="page-header">
    <h2>Add New Employee</h2>
    <p>Create a new employee account</p>
</div>

<div class="card">
    <form method="post" action="/Employee/Create" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
        <div class="form-group">
            <label>Employee Name *</label>
            @Html.TextBoxFor(m => m.EmployeeName, new { @class = "form-control", placeholder = "Enter full name" })
            @Html.ValidationMessageFor(m => m.EmployeeName, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Email *</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter email address", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group password-wrapper">
            <label>Password <span class="text-danger">*</span></label>
            <div style="position:relative;">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter Password", id = "Password", maxlength = "20" })
                <span class="toggle-password" data-target="Password"><i class="fa-regular fa-eye"></i></span>
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>

        <div class="form-group password-wrapper">
            <label>Confirm Password <span class="text-danger">*</span></label>
            <div style="position:relative;">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm Password", id = "ConfirmPassword", maxlength = "20" })
                <span class="toggle-password" data-target="ConfirmPassword"><i class="fa-regular fa-eye"></i></span>
            </div>
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <div class="form-group">
                <label>Mobile Number *</label>
                @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                <label>Date of Birth *</label>
                @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                <label>Age</label>
                <input type="text" class="form-control" id="Age" readonly />
            </div>

            <div class="form-group">
                <label>Gender *</label>

                <label style="margin-left:20px;">
                    @Html.RadioButtonFor(m => m.Gender, "Male") Male
                </label>

                <label style="margin-left:20px;">
                    @Html.RadioButtonFor(m => m.Gender, "Female") Female
                </label>

                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "field-validation-error" })
            </div>
            <label>Department *</label>
            <select id="DepartmentId" name="DepartmentId" class="form-control">
                <option value="">Select Department</option>
                @foreach (var dept in ViewBag.Departments)
                {
                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Role *</label>
            <select id="Role" name="Role" class="form-control">
                <option value="">Select Role</option>
                @foreach (var role in ViewBag.Roles)
                {
                    <option value="@role.RoleName">@role.RoleName</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Salary *</label>
            @Html.TextBoxFor(m => m.Salary, new { @class = "form-control", type = "number", min = "1000", max = "1000000", step = "1" })
            @Html.ValidationMessageFor(m => m.Salary, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Joining Date *</label>
            @Html.TextBoxFor(m => m.JoiningDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.JoiningDate, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Skills *</label>
            <div>
                <label style="margin-left:20px;">
                    <input type="checkbox" name="SelectedSkills" value="C#" /> C#
                </label>

                <label style="margin-left:20px;">
                    <input type="checkbox" name="SelectedSkills" value="SQL" /> SQL
                </label>

                <label style="margin-left:20px;">
                    <input type="checkbox" name="SelectedSkills" value="MVC" /> MVC
                </label>

                <label style="margin-left:20px;">
                    <input type="checkbox" name="SelectedSkills" value="JavaScript" /> JavaScript
                </label>
            </div>
        </div>

        <div class="form-group">
            <label>Address *</label>
            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3", minlength = "10", maxlength = "300" })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Profile Image *</label>
            @Html.TextBoxFor(m => m.ImageFile, new { @class = "form-control", type = "file", accept = ".jpg,.jpeg,.png" })
            @Html.ValidationMessageFor(m => m.ImageFile, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>
                @Html.CheckBoxFor(m => m.IsActive)
                Active
            </label>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Create Employee</button>
            <a href="@Url.Action("Index", "Employee")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>


