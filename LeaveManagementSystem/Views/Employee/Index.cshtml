@model IEnumerable<LeaveManagementSystem.Models.EmployeeModel>
@{
    ViewBag.Title = "Employee Management";
}

<div class="page-header">
    <h2>Employee Management</h2>
    <p>Manage all employees in the system</p>
</div>

<div class="stats-grid">
    <div class="stat-card total">
        <div class="stat-label">Total Employees</div>
        <div class="stat-number">@Model.Count()</div>
    </div>
    <div class="stat-card approved">
        <div class="stat-label">Active Employees</div>
        <div class="stat-number">@Model.Count(e => e.IsActive)</div>
    </div>
    <div class="stat-card pending">
        <div class="stat-label">Departments</div>
        <div class="stat-number">@(ViewBag.Departments?.Count ?? 0)</div>
    </div>
</div>

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
    <div style="margin-bottom: 1rem;">
        <a href="@Url.Action("Create", "Employee")" class="btn btn-primary">+ Add New Employee</a>
    </div>
    <button class="btn btn-success" onclick="exportEmployeeManagement()">
        Export to Excel
    </button>
</div>
    <div id="employeeGrid" class="ag-theme-alpine" style="width: 100%; height: 500px;"></div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/styles/ag-theme-alpine.css">
<script src="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/dist/ag-grid-community.min.js"></script>

<script>
    window.employeeData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(e => new
    {
        EmployeeId = e.EmployeeId,
        EmployeeName = e.EmployeeName,
        Email = e.Email,
        DepartmentName = e.DepartmentName,
        Role = e.Role,
        ProfileImage = e.ProfileImage,
        IsActive = e.IsActive,
        Status = e.IsActive ? "Active" : "Inactive"
    })));
</script>
<script src="~/js/employee.js"></script>

@Html.AntiForgeryToken()


