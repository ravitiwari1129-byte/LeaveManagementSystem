@model IEnumerable<LeaveManagementSystem.Models.LeaveRequestModel>
@{
    ViewBag.Title = "Leave Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/approve-leaves.css" />

<div class="page-header">
    <h2>Pending Leave Approvals</h2>
    <p>Review and approve/reject leave requests</p>
</div>

<div class="stats-grid">
    <div class="stat-card pending">
        <div class="stat-label">Pending Requests</div>
        <div class="stat-number" id="pendingCount">@(Model?.Count() ?? 0)</div>
    </div>
    <div class="stat-card approved">
        <div class="stat-label">Today's Requests</div>
        <div class="stat-number">@(Model?.Count(l => l.AppliedDate.Date == DateTime.Today) ?? 0)</div>
    </div>
    <div class="stat-card total">
        <div class="stat-label">Leave Types</div>
        <div class="stat-number">@(Model?.Select(l => l.LeaveType).Distinct().Count() ?? 0)</div>
    </div>
</div>

<div class="card">
    <div class="card-title">Pending Leave Requests</div>
    @if (Model != null && Model.Any())
    {
        <div style="width: 100%; overflow: hidden; position: relative;">
            <div id="leaveGrid" style="width: 100%; height: 500px; overflow: auto;" class="ag-theme-alpine"></div>
        </div>
    }
    else
    {
        <div class="alert alert-info" style="text-align: center; padding: 2rem;">
            <h3>No Pending Leave Requests</h3>
            <p>All leave requests have been processed.</p>
        </div>
    }
</div>

<div id="actionModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">Confirm Action</h3>
            <span onclick="closeModal()" style="cursor: pointer; float: right; font-size: 24px;">&times;</span>
        </div>
        <div class="modal-body">
            <p id="modalMessage"></p>
            <div class="form-group">
                <label for="remarks">Remarks (Optional)</label>
                <textarea id="remarks" class="form-control" rows="3" placeholder="Add any remarks..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button onclick="closeModal()" class="btn btn-secondary">Cancel</button>
            <button onclick="confirmAction()" class="btn btn-primary">Confirm</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/styles/ag-theme-alpine.css">
<script src="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/dist/ag-grid-community.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    console.log("=== Approve Leaves Page Loaded ===");

    @{
        var hasData = Model != null && Model.Any();
        var jsonData = "[]";
        if (hasData)
        {
            try
            {
                jsonData = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(l => new
                {
                    LeaveId = l.LeaveId,
                    EmployeeName = l.EmployeeName ?? "",
                    LeaveType = l.LeaveType ?? "",
                    FromDate = l.FromDate.ToString("dd MMM yyyy"),
                    ToDate = l.ToDate.ToString("dd MMM yyyy"),
                    Reason = l.Reason ?? "",
                    AppliedDate = l.AppliedDate.ToString("dd MMM yyyy")
                }));
            }
            catch
            {
                jsonData = "[]";
            }
        }
    }

    window.leaveData = @Html.Raw(jsonData);
    console.log("Has Data:", @(hasData ? "true" : "false"));
    console.log("Records Count:", window.leaveData.length);
</script>

<script>
    var gridApi = null;
    function initGrid() 
    {
        console.log("Initializing grid...");
        var gridDiv = document.getElementById('leaveGrid');
        if (!gridDiv) 
        {
            console.error("Grid container not found!");
        return;
    }

    if (typeof agGrid === 'undefined') 
    {
        console.error("AG Grid not loaded!");
        return;
    }

    if (!window.leaveData || window.leaveData.length === 0) 
    {
        console.log("⚠️ No data to display");
        return;
    }

    
    var columnDefs = 
    [
        {
            field: "EmployeeName",
            headerName: "Employee",
            sortable: true,
            filter: true,
            flex: 2,
            minWidth: 150
        },
        {
            field: "LeaveType",
            headerName: "Leave Type",
            sortable: true,
            filter: true,
            flex: 1.5,
            minWidth: 130
        },
        {
            field: "FromDate",
            headerName: "From Date",
            sortable: true,
            flex: 1,
            minWidth: 110
        },
        {
            field: "ToDate",
            headerName: "To Date",
            sortable: true,
            flex: 1,
            minWidth: 110
        },
        {
            field: "Reason",
            headerName: "Reason",
            sortable: true,
            filter: true,
            flex: 3,
            minWidth: 200,
            cellRenderer: function(params) 
            {
                var reason = params.value || "";
                return reason.length > 60 ? reason.substring(0, 60) + "..." : reason;
            }
        },
        {
            field: "AppliedDate",
            headerName: "Applied Date",
            sortable: true,
            flex: 1,
            minWidth: 110
        },
        {
            headerName: "Action",
            sortable: false,
            filter: false,
            flex: 2,
            minWidth: 220,
            cellRenderer: function(params) 
            {
                var leaveId = params.data.LeaveId;
                return '<div style="display: flex; gap: 5px; flex-wrap: nowrap;">' +
                '<button type="button" class="btn btn-success" style="padding: 4px 10px; cursor: pointer; font-size: 12px; white-space: nowrap;" onclick="approveLeave(' + leaveId + ')">Approve</button>' +
                '<button type="button" class="btn btn-danger" style="padding: 4px 10px; cursor: pointer; font-size: 12px; white-space: nowrap;" onclick="rejectLeave(' + leaveId + ')">Reject</button>' +
                '<a href="/Leave/LeaveDetail/' + leaveId + '" class="btn btn-info" style="padding: 4px 10px; text-decoration: none; font-size: 12px; white-space: nowrap;">View</a>' +
                '</div>';
            }
        }
    ];

    try 
    {
        gridApi = agGrid.createGrid(gridDiv, 
            {
                columnDefs: columnDefs,
                rowData: window.leaveData,
                domLayout: 'normal',
                animateRows: true,
                onGridReady: function(params) 
                {
                    console.log("Grid ready!");
                    setTimeout(function() 
                    {
                        params.api.sizeColumnsToFit();
                    }, 100);
                }
            });

        window.addEventListener('resize', function() 
        {
            if (gridApi) 
            {
                setTimeout(function() 
                {
                    gridApi.sizeColumnsToFit();
                }, 100);
            }
        });

        } 
        catch (error) 
        {
            console.error("Error creating grid:", error);
        }
    }

    $(document).ready(function() 
    {
        console.log("📄 Document ready");
        if (window.leaveData && window.leaveData.length > 0) 
        {
            setTimeout(initGrid, 500);
        } 
        else 
        {
            var gridDiv = document.getElementById('leaveGrid');
            if (gridDiv) 
            {
                gridDiv.innerHTML = '<div style="text-align: center; padding: 2rem; color: #666;">No pending leave requests to display</div>';
            }
        }
    });
</script>

<script>
    var currentLeaveId = null;
    var currentAction = null;
    function approveLeave(leaveId) 
    {
        currentLeaveId = leaveId;
        currentAction = "Approved";
        document.getElementById('modalTitle').innerHTML = "Approve Leave Request";
        document.getElementById('modalMessage').innerHTML = "Are you sure you want to approve this leave request?";
        document.getElementById('actionModal').style.display = "flex";
        document.getElementById('remarks').value = '';
    }
    function rejectLeave(leaveId) 
    {
        currentLeaveId = leaveId;
        currentAction = "Rejected";
        document.getElementById('modalTitle').innerHTML = "Reject Leave Request";
        document.getElementById('modalMessage').innerHTML = "Are you sure you want to reject this leave request?";
        document.getElementById('actionModal').style.display = "flex";
        document.getElementById('remarks').value = '';
    }
    function closeModal() 
    {
        document.getElementById('actionModal').style.display = "none";
        currentLeaveId = null;
        currentAction = null;
    }

    function confirmAction() 
    {
        if (!currentLeaveId || !currentAction) 
        {
            alert("No action selected");
            return;
        }
        var remarks = document.getElementById('remarks').value || "";
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
        if (!token) 
        {
            alert("Security token not found. Please refresh the page.");
            return;
        }

        fetch('/Leave/ApproveReject', 
        {
            method: 'POST',
            headers: 
            {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(
                {
                    leaveId: currentLeaveId,
                    status: currentAction,
                    remarks: remarks
                })
            })
            .then(function(response) {
        return response.json();
    })
    .then(function(data) 
    {
        if (data.success) 
        {
            if (gridApi) 
            {
                var allRows = [];
                gridApi.forEachNode(function(node) 
                {
                    allRows.push(node.data);
                });
             var updatedRows = allRows.filter(function(row) {
        return row.LeaveId !== currentLeaveId;
    });
    gridApi.setGridOption('rowData', updatedRows);
    var pendingCountElem = document.getElementById('pendingCount');
    if (pendingCountElem) {
    pendingCountElem.innerHTML = updatedRows.length;
    }

    if (updatedRows.length === 0) 
    {
        var gridDiv = document.getElementById('leaveGrid');
        if (gridDiv) 
        {
            gridDiv.innerHTML = '<div style="text-align: center; padding: 2rem; color: #666;">✅ All pending leaves have been processed!</div>';
        }
    }
    }
    alert("✅ " + data.message);
    closeModal();
    } else {
    alert("❌ " + (data.message || "Failed to process request"));
    }
    })
    .catch(function(error) {
    console.error("Error:", error);
    alert("❌ An error occurred: " + error.message);
    });
    }

    window.onclick = function(event) 
    {
        var modal = document.getElementById('actionModal');
        if (event.target === modal) 
        {
            closeModal();
        }
    };
</script>