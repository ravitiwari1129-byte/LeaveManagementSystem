@model LeaveManagementSystem.Models.LeaveRequestModel
@{
    ViewBag.Title = "Leave Details";
}

<div class="page-header">
    <h2>Leave Request Details</h2>
    <p>Complete information about the leave request</p>
</div>

<div class="card">
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
        <div class="form-group">
            <label><strong>Employee Name:</strong></label>
            <div>@Model.EmployeeName</div>
        </div>
        <div class="form-group">
            <label><strong>Leave Type:</strong></label>
            <div>@Model.LeaveType</div>
        </div>
        <div class="form-group">
            <label><strong>From Date:</strong></label>
            <div>@Model.FromDate.ToString("dd MMM yyyy")</div>
        </div>
        <div class="form-group">
            <label><strong>To Date:</strong></label>
            <div>@Model.ToDate.ToString("dd MMM yyyy")</div>
        </div>
        <div class="form-group">
            <label><strong>Total Days:</strong></label>
            <div>@((Model.ToDate - Model.FromDate).Days + 1) days</div>
        </div>
        <div class="form-group">
            <label><strong>Status:</strong></label>
            <div>
                @{
                    var statusClass = Model.Status == "Pending" ? "badge-pending" : (Model.Status == "Approved" ? "badge-approved" : "badge-rejected");
                }
                <span class="badge @statusClass">@Model.Status</span>
            </div>
        </div>
        <div class="form-group">
            <label><strong>Applied Date:</strong></label>
            <div>@Model.AppliedDate.ToString("dd MMM yyyy HH:mm")</div>
        </div>
        <div class="form-group">
            <label><strong>Approved By:</strong></label>
            <div>@(!string.IsNullOrEmpty(Model.ApprovedByName) ? Model.ApprovedByName : "Not yet approved")</div>
        </div>
        <div class="form-group" style="grid-column: span 2;">
            <label><strong>Reason:</strong></label>
            <div class="card" style="background: #f8f9fa; margin-top: 0.5rem;">@Model.Reason</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <div class="form-group" style="grid-column: span 2;">
                <label><strong>Remarks:</strong></label>
                <div class="card" style="background: #f8f9fa; margin-top: 0.5rem;">@Model.Remarks</div>
            </div>
        }
    </div>

    <div class="form-group" style="margin-top: 1.5rem;">
        <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
        @if (Model.Status == "Pending" && Context.Session.GetString("UserRole") == "Admin")
        {
            <a href="@Url.Action("Index", "Leave")" class="btn btn-primary">Go to Approvals</a>
        }
    </div>
</div>