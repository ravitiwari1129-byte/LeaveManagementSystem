@model LeaveManagementSystem.Models.LeaveRequestModel
@{
    ViewBag.Title = "Apply for Leave";
}

<div class="page-header">
    <h2>Apply for Leave</h2>
    <p>Submit your leave request for approval</p>
</div>

<div class="card">
    <form method="post" action="/Leave/Apply" id="leaveForm">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

        <div class="form-group">
            <label>Leave Type *</label>
            <select asp-for="LeaveType" class="form-control">
                <option value="">Select Leave Type</option>
                @foreach (var type in ViewBag.LeaveTypes)
                {
                    <option value="@type.LeaveTypeName">@type.LeaveTypeName</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.LeaveType, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>From Date *</label>
            @Html.TextBoxFor(m => m.FromDate, Model.FromDate == DateTime.MinValue ? "" : Model.FromDate.ToString("yyyy-MM-dd"), new { @type = "date", @class = "form-control" })
            @Html.ValidationMessageFor(m => m.FromDate, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>To Date *</label>
            @Html.TextBoxFor(m => m.ToDate, Model.ToDate == DateTime.MinValue ? "" : Model.ToDate.ToString("yyyy-MM-dd"), new { @type = "date", @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ToDate, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label>Reason *</label>
            @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", placeholder = "Please provide reason for leave", rows = "4" })
            @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Submit Leave Request</button>
            <a href="@Url.Action("Dashboard", "Report")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script src="~/js/leave.js"></script>

