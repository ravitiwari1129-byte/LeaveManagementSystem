@{
    ViewBag.Title = "Search Leaves";
    var loggedInEmployeeName = Context.Session.GetString("EmployeeName");
    var userRole = Context.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
}

<div class="page-header">
    <h2>Search Leaves</h2>
    <p>Search and filter leave requests</p>
</div>

<div class="filters">
    <div class="filter-row">
        <div class="form-group">
            <label for="searchEmployeeName">Employee Name</label>
            @if (isAdmin)
            {
                <input type="text" id="searchEmployeeName" class="form-control" placeholder="Search by employee name..." />
            }
            else
            {
                <input type="text" id="searchEmployeeName" class="form-control" value="@loggedInEmployeeName" readonly style="background-color: #f0f0f0; cursor: not-allowed;" />
            }
        </div>

        <div class="form-group">
            <label for="searchStatus">Status</label>
            <select id="searchStatus" class="form-control" multiple>
                <option value="All">All</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>

        <div class="form-group">
            <label for="searchFromDate">From Date</label>
            <input type="date" id="searchFromDate" class="form-control" />
        </div>

        <div class="form-group">
            <label for="searchToDate">To Date</label>
            <input type="date" id="searchToDate" class="form-control" />
        </div>
    
    </div>

        <div class="search-buttons">
            <button id="searchBtn" class="btn btn-primary">Search</button>
            <button id="resetSearchBtn" class="btn btn-secondary">Reset</button>
        </div>
</div>

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
    <div class="card-title">Search Results</div>

    <button class="btn btn-success" onclick="exportSearchLeave()">
        Export to Excel
    </button>
</div>
<div id="searchResultGrid" class="ag-theme-alpine" style="width: 100%; height: 500px;"></div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/styles/ag-theme-alpine.css">
<script src="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/dist/ag-grid-community.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

@Html.AntiForgeryToken()

<script src="~/js/site.js"></script>
<script src="~/js/search.js"></script>

<script>
    $(document).ready(function() {

    var isAdmin = @isAdmin.ToString().ToLower();

    $('#searchStatus').select2({
        placeholder: "Select Status",
        width: '100%',
        allowClear: true,
        closeOnSelect: false
    });

    $('#searchStatus').on('change', function () {

        var selectedValues = $(this).val() || [];

        if (selectedValues.includes("All")) {

            var allValues = [];

            $('#searchStatus option').each(function () {
                var value = $(this).val();

                if (value !== "All") {
                    allValues.push(value);
                }
            });

            $('#searchStatus').val(allValues).trigger('change.select2');
        }
    });

    if (!isAdmin && '@loggedInEmployeeName') {
        setTimeout(function () {
            if (typeof performSearch === 'function') {
                performSearch();
            }
        }, 500);
    }
});
</script>

