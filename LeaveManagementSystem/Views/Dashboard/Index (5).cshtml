@* @{
    ViewBag.Title = "Dashboard";
    var dashboard = ViewBag.Dashboard as LeaveManagementSystem.Models.DashboardModel;
    var summary = ViewBag.Summary as LeaveManagementSystem.Models.DashboardModel;
    var userRole = Context.Session.GetString("UserRole");
}

<div class="page-header">
    <h2>Welcome, @ViewBag.UserName!</h2>
    <p>Here's an overview of your leave management system</p>
</div>

<div class="stats-grid">
    <div class="stat-card pending"><div class="stat-label">Pending Requests</div><div class="stat-number">@dashboard?.PendingCount</div></div>
    <div class="stat-card approved"><div class="stat-label">Approved Requests</div><div class="stat-number">@dashboard?.ApprovedCount</div></div>
    <div class="stat-card rejected"><div class="stat-label">Rejected Requests</div><div class="stat-number">@dashboard?.RejectedCount</div></div>
    <div class="stat-card total"><div class="stat-label">This Month</div><div class="stat-number">@dashboard?.MonthlyCount</div></div>
</div>

@if (userRole != "Admin")
{
    <div class="card">
        <div class="card-title">Your Leave Summary</div>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: center;">
            <div><div style="font-size: 1.8rem; font-weight: bold; color: #f39c12;">@summary?.PendingLeaves</div><div style="color: #666;">Pending</div></div>
            <div><div style="font-size: 1.8rem; font-weight: bold; color: #27ae60;">@summary?.ApprovedLeaves</div><div style="color: #666;">Approved</div></div>
            <div><div style="font-size: 1.8rem; font-weight: bold; color: #3498db;">@summary?.TotalDaysTaken</div><div style="color: #666;">Days Taken</div></div>
        </div>
    </div>
}

<div class="card">
    <div class="card-title">Leave Requests Overview</div>
    <div id="myChart" style="width: 100%; height: 400px;"></div>
</div>

<div class="card">
    <div class="card-title">Quick Actions</div>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        @if (userRole == "Admin")
        {
            <a href="@Url.Action("ApproveLeave", "Leave")" class="btn btn-primary">Approve Pending Leaves</a>
            <a href="@Url.Action("Index", "Employee")" class="btn btn-success">Manage Employees</a>
        }
        else
        {
            <a href="@Url.Action("Apply", "Leave")" class="btn btn-primary">Apply for Leave</a>
            <a href="@Url.Action("History", "Leave")" class="btn btn-success">View Leave History</a>
        }
        <a href="@Url.Action("Index", "SearchLeaves")" class="btn btn-warning">Search Leaves</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/ag-charts-community@13.3.1/dist/umd/ag-charts-community.min.js"></script>
<script src="~/js/dashboard.js"></script>
<script>
    window.dashboardData = {
    pendingCount: @(dashboard?.PendingCount ?? 0),
    approvedCount: @(dashboard?.ApprovedCount ?? 0),
    rejectedCount: @(dashboard?.RejectedCount ?? 0)
    };
    // ✅ SIRF YEH EK LINE ADD KARO
    window.userRole = '@userRole';
</script>

@Html.AntiForgeryToken() *@



