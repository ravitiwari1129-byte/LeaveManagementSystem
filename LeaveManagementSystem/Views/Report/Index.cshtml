@{
    ViewBag.Title = "Leave Report";
    var employees = ViewBag.Employees as List<LeaveManagementSystem.Models.EmployeeModel>;
    var userRole = Context.Session.GetString("UserRole");
    var currentName = employees?.FirstOrDefault()?.EmployeeName;
}

<div class="page-header">
    <h2>Leave Report</h2>
    <p>Generate and view leave reports</p>
</div>

<div class="filters">
    <div class="filter-row">
        <div class="form-group">
            <label for="reportEmployeeId">Employee</label>
            @if (ViewBag.userrole == "Admin")
            {
                <select id="reportEmployeeId" multiple>
                <option value="All">All Employees</option>
                @if (employees != null)  
                {
                    foreach (var emp in employees)
                    {
                         <option value="@emp.EmployeeId">@emp.EmployeeName</option>
                    }
                }
                </select>
            }
            else
            {
                <input type="text" id="empid" class="form-control" value="@currentName" />
            }
        </div>

        <div class="form-group">
            <label for="reportStatus">Status</label>
            <select id="reportStatus" multiple>
                <option value="All">All</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>

        <div class="form-group">
            <label for="reportFromDate">From Date</label>
            <input type="date" id="reportFromDate" class="form-control" />
        </div>

        <div class="form-group">
            <label for="reportToDate">To Date</label>
            <input type="date" id="reportToDate" class="form-control" />
        </div>

        <div class="form-group" style="display: flex; gap: 0.5rem;">
            <button id="generateReportBtn" class="btn btn-primary">Generate Report</button>
            <button id="resetReportBtn" class="btn btn-secondary">Reset</button>
        </div>
    </div>
</div>

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
    <div class="card-title">Leave Report Results</div>
    <button class="btn btn-success" onclick="exportLeaveReport()">
        Export to Excel
    </button>
</div>
    <div id="leaveReportGrid" class="ag-theme-alpine" style="width: 100%; height: 500px;"></div>

<script>
    $(document).ready(function() {
        console.log("LeaveReport View Loaded");

        var presetStatus = sessionStorage.getItem('presetStatus');
        if (presetStatus) {
            console.log('Found preset status from chart:', presetStatus);
            $('#reportStatus').val([presetStatus]).trigger('change.select2');

            setTimeout(function() {
                $('#generateReportBtn').click();
                console.log('Report auto-generated with status:', presetStatus);
            }, 500);

            sessionStorage.removeItem('presetStatus');
        }
    });
</script>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/styles/ag-theme-alpine.css">
<script src="https://cdn.jsdelivr.net/npm/ag-grid-community@35.3.1/dist/ag-grid-community.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script src="~/js/report.js"></script>
<script src="~/js/employee.js"></script>

